case $- in
    *i*) ;;
    *) return 0 ;;
esac

_thm_refresh() {
    local t="" prev="${_THM_LAST_TARGET-}"
    local f="${XDG_CONFIG_HOME:-$HOME/.config}/thm/target"
    [ -r "$f" ] && t="$(head -n 1 "$f" 2>/dev/null | tr -cd '0-9.')"
    if [ "$t" != "${_THM_LAST_TARGET-x}" ]; then
        _THM_LAST_TARGET="$t"
        if [ -n "$t" ]; then
            export TARGET="$t" IP="$t"
        else
            [ "${IP:-}" = "$prev" ] && unset IP
            unset TARGET
        fi
    fi
    VPN_IP="$(ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^(tun|tap)/ { split($4, a, "/"); print a[1]; exit }')"
    export VPN_IP
}

thm() {
    if { [ "${1:-}" = room ] || [ "${1:-}" = r ]; } && [ $# -ge 2 ]; then
        local _thm_dir
        _thm_dir="$(command thm "$@")" || return $?
        [ -n "$_thm_dir" ] && [ -d "$_thm_dir" ] && cd "$_thm_dir"
        return 0
    fi
    command thm "$@"
}

alias vpn='thm vpn'

if [ -n "${ZSH_VERSION:-}" ]; then
    [ -r /etc/thm/shell.zsh ] && . /etc/thm/shell.zsh
elif [ -n "${BASH_VERSION:-}" ]; then
    [ -r /etc/thm/shell.bash ] && . /etc/thm/shell.bash
fi
