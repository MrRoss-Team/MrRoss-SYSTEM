{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/mrross/logo.txt",
    "color": { "1": "red", "2": "white" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "white" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "localip",
    {
      "type": "command",
      "key": "VPN THM",
      "text": "ip -4 -o addr show 2>/dev/null | awk '$2 ~ /^(tun|tap)/ { split($4, a, \"/\"); print a[1]; f=1; exit } END { if (!f) print \"offline\" }'"
    },
    "break",
    "colors"
  ]
}
